<!--
  Wazuh SOC Lab — Module SOC-001: Suspicious PowerShell Activity
  Source de données : Sysmon Event ID 1 (Process Creation), canal Microsoft-Windows-Sysmon/Operational
  Cible : Wazuh manager >= 4.x (plage custom 100000-120000)
  Installation : copier dans /var/ossec/etc/rules/ (ou fusionner dans local_rules.xml),
                 valider avec wazuh-logtest, puis redémarrer wazuh-manager.
  Moteur regex : PCRE2 (défaut Wazuh 4.x).
-->
<group name="windows,sysmon,powershell,">

  <!-- RÈGLE DE BASE : toute création de processus PowerShell/pwsh (Event 1) -->
  <!-- Niveau 3 : contexte uniquement, chaîne parent pour les règles enfants -->
  <rule id="100001" level="3">
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <description>Sysmon - Event 1 - PowerShell process created: $(win.eventdata.image) by $(win.eventdata.user)</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Commande encodée (base64) -->
  <rule id="100002" level="12">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-en(?:c|co|codedcommand)\s+[A-Za-z0-9+/=]{20,}|\[convert\]::frombase64string</field>
    <description>PowerShell - Encoded command detected (possible obfuscated payload)</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
      <id>T1140</id>
    </mitre>
  </rule>

  <!-- Exécution en fenêtre masquée -->
  <rule id="100003" level="8">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-windowstyle\s+(hidden|0)|-w\s+(hidden|0)</field>
    <description>PowerShell - Hidden window execution (-WindowStyle Hidden)</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1564.003</id>
    </mitre>
  </rule>

  <!-- Contournement de politique d'exécution -->
  <rule id="100004" level="8">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(executionpolicy|ex|ep)\s+(bypass|unrestricted)</field>
    <description>PowerShell - Execution policy bypass detected</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <!-- Download cradle / exécution IEX -->
  <rule id="100005" level="12">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(invoke-expression|iex\s+\(|new-object\s+net\.webclient|downloadstring|downloadfile|invoke-webrequest|iwr\s|start-bitstransfer|system\.net\.webclient|system\.net\.httpclient)</field>
    <description>PowerShell - Download cradle detected (possible in-memory payload delivery)</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- Réflexion / chargement d'assembly en mémoire -->
  <rule id="100006" level="10">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\[reflection\.assembly\]|\[system\.reflection|add-type|\.load\(|loadfrom\(|unsafegetstring)</field>
    <description>PowerShell - Reflection / in-memory assembly loading</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1140</id>
    </mitre>
  </rule>

  <!-- Mots-clés d'accès aux identifiants -->
  <rule id="100007" level="13">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(mimikatz|invoke-mimikatz|sekurlsa|dumpcred|comsvcs|minidump|lsass\.exe\s+-dump)</field>
    <description>PowerShell - Credential dumping indicators detected</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!-- Corrélation : rafale de créations PowerShell (staging de payload) -->
  <rule id="100008" level="12" frequency="8" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <description>PowerShell - High volume of process creations in 2 minutes (possible automated execution)</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Parent Office (chaîne d'attaque macro / document) -->
  <rule id="100009" level="13">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(winword|excel|powerpnt|outlook|msaccess)\.exe$</field>
    <description>PowerShell - Spawned from a Microsoft Office application (possible macro execution)</description>
    <group>powershell,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1204.002</id>
    </mitre>
  </rule>

</group>
